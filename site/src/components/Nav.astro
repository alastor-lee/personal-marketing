---
const links = [
  { href: '/', label: 'Home' },
  { href: '/resume', label: 'Resumé' },
  { href: '/blog', label: 'Blog' },
  { href: '/projects', label: 'Projects' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/contact', label: 'Contact' },
];

// Normalize the current path (drop trailing slash) for active-link styling.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav
  class="sticky top-0 z-40 border-b border-border bg-surface/90 backdrop-blur supports-[backdrop-filter]:bg-surface/70"
>
  <ul class="mx-auto flex max-w-4xl items-center justify-center gap-1 px-4 py-2 font-mono text-sm">
    {
      links.map(({ href, label }) => {
        const active = href === '/' ? path === '/' : path.startsWith(href);
        return (
          <li>
            <a
              href={href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'block rounded-md px-3 py-2 transition-colors hover:bg-accent-dim/40 hover:text-accent-soft',
                active ? 'text-accent-soft' : 'text-muted',
              ]}
            >
              {label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
