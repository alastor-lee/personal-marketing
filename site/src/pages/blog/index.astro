---
import Layout from '../../layouts/Layout.astro';
import { getPublishedPosts, formatDate } from '../../lib/blog';

const posts = await getPublishedPosts();
---

<Layout title="Blog" description="Writing by Alastor Curns on software, the web, and building things.">
  <div class="flex items-center justify-between gap-4">
    <h1 class="font-mono text-3xl font-semibold text-accent-soft">Blog</h1>
    <a
      href="/rss.xml"
      class="font-mono text-sm text-muted transition-colors hover:text-accent-soft"
    >
      RSS
    </a>
  </div>

  {posts.length === 0 && <p class="mt-8 text-muted">No posts yet — check back soon.</p>}

  <ul class="mt-8 flex flex-col gap-16">
    {
      posts.map((post) => (
        <li>
          <article>
            <a href={`/blog/${post.id}/`} class="group block">
              <div class="flex items-baseline gap-3">
                <h2 class="font-mono text-xl text-fg transition-colors group-hover:text-accent-soft">
                  {post.data.title}
                </h2>
                {post.data.draft && (
                  <span class="rounded border border-accent/40 px-1.5 py-0.5 font-mono text-xs text-accent">
                    draft
                  </span>
                )}
              </div>
              <time datetime={post.data.date.toISOString()} class="font-mono text-sm text-muted">
                {formatDate(post.data.date)}
              </time>
              <p class="mt-2 text-muted">{post.data.description}</p>
            </a>
          </article>
        </li>
      ))
    }
  </ul>
</Layout>
